# apps/web (.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Edge Function secrets (set with: supabase secrets set KEY=value). Never put these in the web app.
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions.
# PIPELINE_SHARED_SECRET protects run-step from being called by anything but pg_net; also stored in Vault (see migrations).
PIPELINE_SHARED_SECRET=change-me-to-a-long-random-string
# Optional model overrides
ENGINE_DEFAULT_MODEL=claude-opus-5-5
ENGINE_COLD_READ_MODEL=claude-sonnet-5-5
