{
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^1.1.0",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.58.0",
    "zod": "npm:zod@^4.1.0",
    "docx": "npm:docx@^9.5.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "engine/": "./_shared/engine/",
    "shared/": "./_shared/",
    "@anthropic-ai/sdk/helpers/zod": "npm:@anthropic-ai/sdk@^1.1.0/helpers/zod",
    "unpdf": "npm:unpdf@1.3.2",
    "mammoth": "npm:mammoth@1.11.0"
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "test": "deno test --allow-read --allow-env --allow-net ./_shared ./tests",
    "engine": "deno run --allow-read --allow-write --allow-env --allow-net ../../tools/engine-cli/main.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 110,
    "singleQuote": false
  }
}
